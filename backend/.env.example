# ============================================================
# Formora Backend — Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://formora:formora_pass@localhost:5432/formora_db

# ── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

# ── Encryption (AES-256-GCM for profile fields) ──────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_32_byte_hex_encryption_key

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

# ── SMTP (use Mailtrap for dev) ──────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=noreply@formora.app

# ── Redis (BullMQ queues) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Google Vision API (OCR) ───────────────────────────────
# Paste the full JSON content of your service account key
GOOGLE_VISION_CREDENTIALS_JSON=

# ── OpenAI (AI Mapping Engine) ────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
S3_BUCKET=formora-documents
